# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLOUD_VISION_API_KEY: Optional backend key for Google Cloud Vision DOCUMENT_TEXT_DETECTION.
# When omitted, the server automatically uses Gemini Vision Multimodal OCR via GEMINI_API_KEY.
GOOGLE_CLOUD_VISION_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string (MongoDB Atlas or self-hosted) for storing user accounts & health profiles.
# Configure this in your runtime secrets or .env file.
MONGODB_URI=""
MONGODB_DB_NAME="NutriCheck"
