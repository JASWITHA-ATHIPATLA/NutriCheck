{
  "manifest_version": 3,
  "name": "NutriCheck – Amazon Food Health Analyzer",
  "version": "1.0.0",
  "description": "Detects Add to Cart clicks on Amazon food items and sends nutrition data to your NutriCheck ML analyzer for instant Good/Moderate/Not Good alerts.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.in/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.de/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.in/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.de/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HealthGuard Settings"
  }
}
