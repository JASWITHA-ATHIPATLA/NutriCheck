{
  "manifest_version": 3,
  "name": "NutriCheck – Food & Store Ingredient Analyzer",
  "version": "1.2.0",
  "description": "Scans food ingredients and nutrition facts across Amazon, Flipkart, Swiggy Instamart, Zomato, and Blinkit and syncs easy summaries to NutriCheck.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.in/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.ca/*",
    "https://*.amazon.de/*",
    "https://*.flipkart.com/*",
    "https://*.swiggy.com/*",
    "https://*.zomato.com/*",
    "https://*.blinkit.com/*",
    "https://*.openfoodfacts.org/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.vercel.app/*",
    "https://*.netlify.app/*",
    "https://*.run.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.in/*",
        "https://*.amazon.co.uk/*",
        "https://*.amazon.ca/*",
        "https://*.amazon.de/*",
        "https://*.flipkart.com/*",
        "https://*.swiggy.com/*",
        "https://*.zomato.com/*",
        "https://*.blinkit.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://*.vercel.app/*",
        "https://*.netlify.app/*",
        "https://*.run.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NutriCheck Store Watcher"
  }
}
